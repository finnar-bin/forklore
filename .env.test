# Used only by `npm run test:e2e` (vite --mode test). Not real credentials —
# every request to this host is intercepted by Playwright route mocks in
# e2e/mocks/mockBackend.ts before it ever reaches the network, so the app
# never actually connects to any Supabase project (dev, prod, or otherwise).
# See e2e/README.md.
VITE_SUPABASE_URL=https://mock.supabase.test
VITE_SUPABASE_ANON_KEY=e2e-mock-anon-key
