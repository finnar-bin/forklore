# Copy to .env.dev and fill in real values. .env.dev is gitignored — never commit it.

# Frontend runtime config (read via import.meta.env by the Vite app)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used by `npm run supabase:push:dev` (scripts/supabase-push.sh) to link and
# push migrations to this environment's Supabase project. Requires you to
# have already run `npx supabase login` once (interactive) on this machine.
SUPABASE_PROJECT_REF=
