# Copy to .env.prod and fill in real values. .env.prod is gitignored — never commit it.

# Frontend runtime config (read via import.meta.env by the Vite app)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used by `npm run supabase:push:prod` (scripts/supabase-push.sh) and
# `npm run supabase:deploy-functions:prod` (scripts/supabase-deploy-functions.sh)
# to link to this environment's Supabase project.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# NOT read from this file — these are Edge Function secrets for
# get-upload-url, set on the Supabase project itself via `supabase secrets
# set R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=... R2_PUBLIC_URL=... --project-ref <ref>`. They must never be
# VITE_-prefixed or otherwise reach the browser bundle. Listed here only so
# it's documented what needs to exist:
#   R2_ACCOUNT_ID      Cloudflare account id
#   R2_ACCESS_KEY_ID    R2 API token access key id
#   R2_SECRET_ACCESS_KEY  R2 API token secret access key
#   R2_BUCKET          R2 bucket name (public access enabled)
#   R2_PUBLIC_URL      Public base URL for the bucket (r2.dev subdomain or custom domain, no trailing slash)
