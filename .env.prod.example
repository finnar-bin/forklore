# Copy to .env.prod and fill in real values. .env.prod is gitignored — never commit it.

# Frontend runtime config (read via import.meta.env by the Vite app)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used by `npm run supabase:push:prod` (scripts/supabase-push.sh) to link and
# push migrations to this environment's Supabase project.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
